---
import TableOfContents from '@astrojs/starlight/components/TableOfContents.astro';

const { toc } = Astro.locals.starlightRoute;
---

<div class="reading-pane">
	{toc && (
		<div class="contents-panel print:hidden">
			<details class="contents">
				<summary>Contents</summary>
				<TableOfContents />
			</details>
		</div>
	)}
	<slot />
</div>

<style>
	.reading-pane {
		min-width: 0;
		isolation: isolate;
	}
	.contents-panel {
		padding: 2rem var(--sl-content-pad-x) 0;
	}
	.contents {
		max-width: var(--sl-content-width);
		margin-inline: auto;
		font-size: 0.875rem;
	}
	summary {
		width: fit-content;
		cursor: pointer;
		color: var(--sl-color-gray-2);
		padding-block: 0.5rem;
	}
	summary:hover {
		color: var(--sl-color-white);
	}
	.contents :global(nav) {
		padding-block: 0.75rem;
	}
	.contents :global(h2) {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.contents :global(a) {
		color: var(--sl-color-gray-2);
		text-decoration: none;
	}
	.contents :global(a:hover),
	.contents :global(a[aria-current='true']) {
		color: var(--sl-color-text-accent);
	}
</style>
